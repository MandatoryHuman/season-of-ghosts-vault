filters:
  and:
    - file.folder == "1. World Almanac/Locations/Settlements/Willowshore"
views:
  - type: table
    name: all-locations
  - type: table
    name: buisinesses
    filters:
      and:
        - file.hasTag("business")
    order:
      - file.name
      - buildingtype
      - owner
  - type: table
    name: temples-and-shrines
    filters:
      and:
        - file.hasTag("shrine")
    order:
      - file.name
      - buildingtype
      - owner
  - type: table
    name: residential
    filters:
      and:
        - file.hasTag("residential")
    order:
      - file.name
      - owner
